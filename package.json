{
   "name": "@bdsqqq/try",
   "version": "2.3.1",
   "description": "Don't let the Try Catch Tower of Terror destroy your beautiful one liners.",
   "type": "module",
   "main": "dist/index.cjs",
   "module": "dist/index.mjs",
   "types": "dist/index.d.mts",
   "exports": {
      ".": {
         "types": {
            "import": "./dist/index.d.mts",
            "require": "./dist/index.d.cts"
         },
         "import": "./dist/index.mjs",
         "require": "./dist/index.cjs"
      }
   },
   "packageManager": "pnpm@10.34.5",
   "scripts": {
      "build": "tsdown src/index.ts --format cjs --format esm --dts --target es2015",
      "lint": "eslint src --max-warnings=0",
      "lint:fix": "eslint src --fix",
      "prettier": "prettier --write ./src/**/*.{js,ts}",
      "test": "node --experimental-strip-types --test src/index.test.ts",
      "typecheck": "tsc --noEmit"
   },
   "files": [
      "dist/**/*"
   ],
   "repository": {
      "type": "git",
      "url": "git+https://github.com/bdsqqq/try.git"
   },
   "author": "Igor Bedesqui",
   "license": "MIT",
   "devDependencies": {
      "@eslint/js": "^9.39.5",
      "@types/node": "^22.20.1",
      "eslint": "^9.39.5",
      "eslint-config-prettier": "^10.1.8",
      "eslint-plugin-prettier": "^5.5.6",
      "prettier": "^3.9.6",
      "tsdown": "^0.22.14",
      "typescript": "^5.9.3",
      "typescript-eslint": "^8.67.0"
   }
}
